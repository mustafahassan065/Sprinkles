# LOCAL DEVELOPMENT — koi install nahi chahiye, SQLite automatically use hoga
# Is file ko .env.local naam se copy karo
# DATABASE_URL mat likho local mein — SQLite automatically use hoga

# ── VPS PRODUCTION ONLY ──
# Sirf VPS pe deploy karte waqt uncomment karo:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/sprinklers_lawns

# Node environment
NODE_ENV=development
